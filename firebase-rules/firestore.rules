rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacher() {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/teachers/$(request.auth.uid))
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.role == 'teacher'
        && get(/databases/$(database)/documents/teachers/$(request.auth.uid)).data.active == true;
    }

    match /teachers/{uid} {
      // 教師帳號與角色文件由專案管理者在 Firebase Console 維護。
      // 用戶只能讀取自己的角色文件，不能自行授予或移除教師權限。
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /students/{email} {
      allow get: if request.auth != null;
      allow list: if isTeacher();
      allow create, update, delete: if isTeacher();
    }

    match /scores/{scoreId} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.unitName in [
          'G2B3',
          'G2B3L21',
          'DynaSoKOBAN',
          'silklemmings'
        ]
        && request.resource.data.status == 'pending_review'
        && (request.resource.data.unitName != 'silklemmings' || (request.resource.data.completed == true && request.resource.data.bonusScore == 0 && request.resource.data.score == request.resource.data.totalScore))
        && request.resource.data.baseScore is int
        && request.resource.data.baseScore >= 0
        && request.resource.data.baseScore <= (request.resource.data.unitName == 'silklemmings' ? 9007199254740991 : 1000)
        && request.resource.data.bonusScore is int
        && request.resource.data.bonusScore >= 0
        && request.resource.data.bonusScore <= 150
        && (request.resource.data.bonusScore == 0 || request.resource.data.hiddenLevelCompleted == true)
        && request.resource.data.totalScore is int
        && request.resource.data.totalScore >= 0
        && request.resource.data.totalScore <= (request.resource.data.unitName == 'silklemmings' ? 9007199254740991 : 1000)
        && request.resource.data.totalScore == request.resource.data.baseScore + request.resource.data.bonusScore
        && request.resource.data.hiddenLevelUnlocked is bool
        && request.resource.data.hiddenLevelCompleted is bool
        && (!request.resource.data.hiddenLevelCompleted || request.resource.data.hiddenLevelUnlocked)
        && request.resource.data.hiddenLevelScore is int
        && request.resource.data.hiddenLevelScore >= 0
        && request.resource.data.hiddenLevelScore <= 1000
        && request.resource.data.hiddenLevelDurationSeconds is int
        && request.resource.data.hiddenLevelDurationSeconds >= 0
        && request.resource.data['class'] is string
        && request.resource.data['seat'] is string
        && request.resource.data.name is string
        && get(/databases/$(database)/documents/students/$(request.resource.data.email)).data['class'] == request.resource.data['class']
        && get(/databases/$(database)/documents/students/$(request.resource.data.email)).data['seat'] == request.resource.data['seat'];

      // 成績包含個資，第一階段不直接開放查詢排行榜。
      // 排行榜應改由教師核對後的安全彙總資料提供。
      // Only the submitting session may verify its own Silk Road receipt.
      allow get: if isTeacher() || (request.auth != null
        && resource.data.unitName == 'silklemmings'
        && resource.data.uid == request.auth.uid);
      allow list: if isTeacher();

      allow update, delete: if false;
    }

    match /users/{uid} {
      allow read, create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if false;
    }
  }
}
